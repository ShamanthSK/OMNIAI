# ========================================================
# OmniAI Production Environment Variables Template
# ========================================================

# Project Setup
PROJECT_NAME="OmniAI"
ENVIRONMENT="production"
SECRET_KEY="replace_with_a_secure_random_string"

# AI Provider API Keys (Leave blank to enable Demo Mode for unconfigured models)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Database Configuration (Default: SQLite zero-config, or PostgreSQL + pgvector)
DATABASE_URL="sqlite+aiosqlite:///./omniai.db"

# Server Port (Default 8080 for Google Cloud Run)
PORT=8080
